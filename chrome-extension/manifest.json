{
  "manifest_version": 3,
  "name": "Internly",
  "version": "0.1.0",
  "description": "Internship application tracker",

  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],

  "background": {
    "service_worker": "background/serviceWorker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/contentScript.js"]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  }
}
